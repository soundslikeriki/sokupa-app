# Google AI Studio / Vertex で発行した API キー
GEMINI_API_KEY=
# @ai-sdk/google（/api/order-from-ocr）用。未設定なら GEMINI_API_KEY にフォールバック
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。クライアントに絶対に載せないこと
SUPABASE_SERVICE_ROLE_KEY=

# 管理画面アクセス制御（LINEユーザーID）
ADMIN_LINE_USER_ID=

# 署名セッション用。32バイト以上の専用シークレット（サーバー専用）。環境別に別値を安全に設定。
# このテンプレートに実値を記入しないこと。生成・登録は公開前に承認を得て実施。
SESSION_SECRET=
# 内部ワーカーの再開エンドポイント用（既存値を維持）。クライアントへ渡さない。
ANALYSIS_JOB_SECRET=
# LINE Login（既存チャネル設定を維持）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=
# Messaging API（利用者本人への完了通知）
LINE_CHANNEL_ACCESS_TOKEN=

# Vercel Cron構成で必要。個別確認後に環境別の専用値を設定。未設定ならBearer経路は無効。
CRON_SECRET=

# 既定は停止。interactive は画面からの処理・再開（DB側の同じモード設定も必要）。
# scheduled は開始が30秒以上離れたCronの成功完了2回を確認した後に使う。
ANALYSIS_BACKGROUND_MODE=disabled

# Supabase scheduler candidate: dedicated signing key and exact HTTPS origin, only after individual approval.
# Leave blank until the isolated scheduler tests and deployment-protection checks pass.
ANALYSIS_DISPATCH_SECRET=
ANALYSIS_DISPATCH_ORIGIN=
